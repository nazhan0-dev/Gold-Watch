# Copy to .env and change the values. Never commit the real .env file.

# --- MySQL ---
MYSQL_DATABASE=goldtracker
MYSQL_USER=goldtracker
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
MYSQL_PORT=3306

# --- Backend (Spring Boot) ---
BACKEND_PORT=8080
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# How often prices are fetched (ISO-8601 duration, e.g. PT5M = 5 minutes).
SCHEDULER_INTERVAL=PT5M

# --- Frontend (Next.js) ---
FRONTEND_PORT=3000
# URL the *browser* uses to reach the backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
